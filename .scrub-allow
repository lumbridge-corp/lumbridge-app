# Accepted hits of scripts/scrub-check. One entry per line: <path glob>:<regex>
# The matching text is cut from lines of matching files before the check, so
# an entry allows exactly that text and nothing else on the line.
# Every entry has its reason above it. Keep the list short.

# Example hosts and home folders in unit tests: a 10.0.0.x test vector, stand-in
# users (probe, can, ghostty.user, someone, x) and a folder named home inside a
# benchmark's own scratch folder.
scripts/machine-add.test.ts:\b10\.0\.0\.[0-9]{1,3}\b
src/files.rs:/home/probe\b
src/model.rs:/home/can\b|/Users/can\b|C:\\Users\\can\b|C:/Users/can\b
src/links.rs:/Users/ghostty\.user\b
defaults/mods/worktree/main.js:C:/Users/x\b|C:\\Users\\x\b
scripts/bench.py:\{ROOT\}/home/
vendor/gpui-kit/crates/shell/src/runtime.rs:/home/someone/

# Third-party code and licence texts carry their authors' addresses. They must stay as they are.
THIRD-PARTY-NOTICES:[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[a-z]{2,}\b
licenses/*.txt:[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[a-z]{2,}\b
vendor/*/Cargo.toml:[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[a-z]{2,}\b
# A Windows batch line, not an address.
vendor/gpui-kit/crates/shell/src/process.rs:\\n@ping\.exe

# The Pretty view: a comment explaining how Claude Code turns a folder into a
# project name (stand-in folder /home/a), and a made-up transcript fixture whose
# working folder is /home/demo.
defaults/mods/pretty/transcript.js:/home/a\b
tests/fixtures/pretty/transcript.jsonl:/home/demo\b

# README credits the project Lumbridge started from.
README.md:\[Herdr\]\(https://github\.com/herdrdev/herdr[a-z-]*\)
