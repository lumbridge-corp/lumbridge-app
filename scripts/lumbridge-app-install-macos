#!/bin/bash
# Installs Lumbridge on this Mac:
#   ~/Applications/Lumbridge.app (com.lumbridgecorp.app), ~/.local/bin/lumbridge-app
# Uses target/release/lumbridge-app (build it first: nice cargo build --release --locked).
# Its home is ~/.config/lumbridge-app.
set -euo pipefail
[[ $(uname -s) == Darwin ]] || { echo 'macOS only.' >&2; exit 1; }
cd "$(dirname "$0")/.."
bin=target/release/lumbridge-app
[[ -x $bin ]] || { echo "no $bin: build first" >&2; exit 1; }
version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
rev=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)

app="$HOME/Applications/Lumbridge.app"
# The app's CLI link (src/core_bin/cli_link.rs) expects Lumbridge.app/Contents/MacOS/Lumbridge.
exe="Lumbridge"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$HOME/.local/bin"
cp "$bin" "$app/Contents/MacOS/$exe.new"
mv -f "$app/Contents/MacOS/$exe.new" "$app/Contents/MacOS/$exe"
chmod +x "$app/Contents/MacOS/$exe"
cp LICENSE THIRD-PARTY-NOTICES "$app/Contents/Resources/" 2>/dev/null || true

# Icon from assets/lumbridge/lumbridge-app.png.
iconset=$(mktemp -d)/lumbridge-app.iconset; mkdir -p "$iconset"
for s in 16 32 128 256 512; do
  sips -z $s $s assets/lumbridge/lumbridge-app.png --out "$iconset/icon_${s}x${s}.png" >/dev/null
  sips -z $((s*2)) $((s*2)) assets/lumbridge/lumbridge-app.png --out "$iconset/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns "$iconset" -o "$app/Contents/Resources/lumbridge-app.icns"

cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>$exe</string>
    <key>CFBundleIdentifier</key><string>com.lumbridgecorp.app</string>
    <key>CFBundleName</key><string>Lumbridge</string>
    <key>CFBundleDisplayName</key><string>Lumbridge</string>
    <key>CFBundleIconFile</key><string>lumbridge-app</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$rev</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in Lumbridge can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in Lumbridge can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in Lumbridge can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
/usr/libexec/PlistBuddy -c "Add :LSEnvironment:PATH string $HOME/.local/bin:/opt/homebrew/bin:$PATH" "$app/Contents/Info.plist"
codesign --force --sign - "$app"
ln -sfn "$app/Contents/MacOS/$exe" "$HOME/.local/bin/lumbridge-app"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
echo "Installed $app ($version, $rev). Run: open -a Lumbridge   or: lumbridge-app"
